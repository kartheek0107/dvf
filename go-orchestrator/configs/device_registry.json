        "bar0": {
          "type": "memory",
          "size_bytes": 4096,
          "description": "256x32-bit register file via MMIO"
        }
      },
      "test_suites": [
        "smoke/register_rw",
        "smoke/offset_sweep",
        "regression/patterns",
        "regression/persistence",
        "stress/concurrent_rw",
        "stress/throughput",
        "error/boundaries"
      ]
    }
  ]
}
