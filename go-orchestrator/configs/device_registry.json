{
  "devices": [
    {
      "id": "gpgpu",
      "name": "Custom GPGPU Accelerator",
      "vendor_id": "0x1222",
      "device_id": "0x2221",
      "pci_class": "0x0b40",
      "qemu_device_name": "gp_gpu",
      "driver_module": "gpgpu_driver",
