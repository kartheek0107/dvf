# =============================================================================
# DVF Environment Configuration
#
# Copy this file and source it before running any DVF script:
#
#   cp .env.example .env
#   source .env
#
# All variables have sensible defaults — override only what differs on your
# machine.  GitLab CI runners can also set these via CI/CD → Variables.
# =============================================================================

# ── Repository root (auto-detected, rarely needs override) ───────────────────
export DVF_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ── Linux kernel source tree ─────────────────────────────────────────────────
# Required for compiling kernel driver modules (.ko).
# Clone:  git clone --depth=1 --branch v6.6 https://github.com/torvalds/linux $KERNEL_BUILD_DIR
# Build:  cd $KERNEL_BUILD_DIR && make defconfig && make -j$(nproc)
export KERNEL_BUILD_DIR="$HOME/VirtualMachines/linux"

# ── QEMU version to build ───────────────────────────────────────────────────
# The build_qemu_with_models.sh script clones this tag from gitlab.com/qemu-project/qemu
export QEMU_VERSION="v8.2.0"

# ── Guest VM rootfs ──────────────────────────────────────────────────────────
# Build from the included Packer template:  cd guest-os && make build && make install
export ROOTFS_PATH="$HOME/qemu-rootfs/rootfs.ext4"

# ── 9p shared directory (host ↔ guest file exchange) ─────────────────────────
export SHARE_DIR="$HOME/qemu-rootfs/share"

# ── CDAC / Vishwa source (proprietary — obtain from CDAC) ────────────────────
# Set to empty string or leave unset to skip Vishwa tests.
# deploy_share.sh accepts --skip-vishwa-build to bypass this dependency.
export VISHWA_CODE_DIR="$HOME/cdac/FW_SW_Milestone_2/code"

# ── Storage backend ─────────────────────────────────────────────────────────
# "postgres" requires docker-compose up -d, "memory" needs nothing.
export DVF_STORAGE="postgres"
